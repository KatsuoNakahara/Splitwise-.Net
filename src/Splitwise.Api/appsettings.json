{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=splitwise.db"
  },
  "Jwt": {
    "Key": "CHANGE-ME-development-only-key-at-least-32-characters-long",
    "Issuer": "Splitwise.Api",
    "Audience": "Splitwise.Client",
    "ExpiresMinutes": 120
  }
}
